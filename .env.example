# AWS Cognito public application configuration
# These values identify a public Cognito app client. Never add a client secret.
NEXT_PUBLIC_COGNITO_USER_POOL_ID=
NEXT_PUBLIC_COGNITO_USER_POOL_CLIENT_ID=
NEXT_PUBLIC_COGNITO_DOMAIN=
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000

# Optional authentication features
NEXT_PUBLIC_ENABLE_GOOGLE_AUTH=false
NEXT_PUBLIC_ENABLE_TOTP_MFA=false
NEXT_PUBLIC_ENABLE_EMAIL_MFA=false
